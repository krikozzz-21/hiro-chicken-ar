	<script type="text/javascript" nonce="efd0307a-62d3-481c-aac9-69eaa438d2a8">
                (function() {
                    if (!_spPageContextInfo) { return; }

                    function appendPreconnectLinks(host) {
                        try {
                            // DNS prefetch
                            var dns = document.createElement("link");
                            dns.rel = "dns-prefetch";
                            dns.href = host;
                            document.head.appendChild(dns);

                            // Preconnect
                            var preconnect = document.createElement("link");
                            preconnect.rel = "preconnect";
                            preconnect.href = host;
                            preconnect.crossOrigin = "";
                            document.head.appendChild(preconnect);
                        } catch(e) {
                            // do nothing
                        }
                    }

                  if (_spPageContextInfo.MediaTAServiceHostUrl) {
                      appendPreconnectLinks(_spPageContextInfo.MediaTAServiceHostUrl);
                  }
                  if (_spPageContextInfo.OfficeMediaFlightingConfiguration && _spPageContextInfo.OfficeMediaFlightingConfiguration.ClientToServiceEndpoint) {
                      appendPreconnectLinks(_spPageContextInfo.OfficeMediaFlightingConfiguration.ClientToServiceEndpoint);
                  }
                })();</script>
